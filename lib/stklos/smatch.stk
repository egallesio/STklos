;; smatch---reduced Wright-Cartwright-Shinn pattern matcher
;; This code is adapted from Alex Shinn’s public domain match-simple
;; but rewritten to unhygienic define-macro-s

(define-module (stklos smatch)
  (import (srfi 1))
  (export match
          match-lambda
          match-lambda*
          match-let
          match-let*
          match-letrec)

  (define-macro (match expr . clauses)

    (define (clause->vars pattern)
      (cond
       ((symbol? pattern)
        (if (eq? pattern '_) `() (list pattern)))

       ((or (number? pattern) (boolean? pattern) (string? pattern) (char? pattern))
        `())

       ((null? pattern)
        `())

       ((pair? pattern)
        (let ((patt  (car pattern))
              (patts (cdr pattern)))
          (cond
           ;; QUOTE
           ((and (eq? patt 'quote) (pair? patts) (null? (cdr patts))) ;; (quote X)
            `())
           ;; NOT
           ((and (eq? patt 'not) (pair? patts) (null? (cdr patts))) ;; (not X)
            `())
           ;; AND
           ((eq? patt 'and)
            (apply append
                       (map clause->vars patts)))
           ;; OR     FIXME: This is tricky, as clauses might contain arbitrarily
           ;;        differing cases?
           ((eq? patt 'or)
            (apply append
                       (map clause->vars patts)))
           ;; (? PREDICATE) or (? PREDICATE ...)
           ((eq? patt '?)
            (if (and (pair? patts) (null? (cdr patts)))
                `()
                (clause->vars `(and ,@patts))))
           ;; (xxx ...) or (xxxx ___)
           ((or (equal? patts '(|...|)) (equal? patts '(|___|)))
            (clause->vars patt))
           ;; General list
           (else (append (clause->vars patt)
                         (clause->vars patts))))))

       ((vector? pattern)
        (clause->vars (vector->list pattern)))

       (else
        (error "unrecognized pattern: ~s" pattern))))

    ;; ----------------------------------------------------------------------
    (define (clause->condition var pattern)
      (cond
       ((symbol? pattern)
        #t)

       ((or (number? pattern) (boolean? pattern) (string? pattern) (char? pattern))
        `(equal? ,var ,pattern))

       ((null? pattern)
        `(null? ,var))

       ((pair? pattern)
        (let ((patt   (car pattern))
              (patts (cdr pattern)))
          (cond
           ;; QUOTE
           ((and (eq? patt 'quote) (pair? patts) (null? (cdr patts))) ;; (quote X)
            `(equal? ,var ',(car patts)))
           ;; NOT
           ((and (eq? patt 'not) (pair? patts) (null? (cdr patts))) ;; (not X)
            `(not ,(clause->condition var (car patts))))
           ;; AND
           ((eq? patt 'and)
            `(and ,@(map (lambda [p] (clause->condition var p)) patts)))
           ;; OR
           ((eq? patt 'or)
            `(or ,@(map (lambda [p] (clause->condition var p)) patts)))
           ;; (? PREDICATE ...)
           ((eq? patt '?)
            (if (and (pair? patts) (null? (cdr patts)))
                `(,(car patts) ,var)             ;; only (? predicate)
                `(and (,(car patts) ,var)        ;; general case (? predicate x ...)
                      ,@(map (lambda [p] (clause->condition var p)) patts))))
           ;; (xxx ...) or (xxxx ___)
           ((or (equal? patts '(|...|)) (equal? patts '(|___|)))
            (let ([param-var (gensym "list-param")])
              `(and (list? ,var)
                    (every (lambda [,param-var]
                             ,(clause->condition param-var patt))
                           ,var))))
           ;; A general list
           (else
            (let ([car-var (gensym "car")]
                  [cdr-var (gensym "cdr")])
              `(and (pair? ,var)
                    (let ([,car-var (car ,var)]
                          [,cdr-var (cdr ,var)])
                      (and ,(clause->condition car-var (car pattern))
                           ,(clause->condition cdr-var (cdr pattern))))))))))

       ((vector? pattern)
        (if (zero? (vector-length pattern))
            `(and (vector? ,var)                      ;; vector is  #()
                  (equal? ,var #()))
            (let ([car-var (gensym "car-v")]          ;; length is > 0
                  [cdr-var (gensym "cdr-v")]
                  [patt    (gensym "pattern")]
                  (lst     (vector->list pattern)))
              `(and (vector? ,var)
                    (positive? (vector-length ,var))
                    (let* ([,patt (vector->list ,var)]
                           [,car-var (car ,patt)]
                           [,cdr-var (cdr ,patt)])
                      (and ,(clause->condition car-var (car lst))
                           ,(clause->condition cdr-var (cdr lst))))))))

       (else
        (error "unrecognized pattern: ~s" pattern))))


    (define (clause->bindings var pattern)
      (cond
       ((symbol? pattern)
        (if (eq? pattern '_) `() `((,pattern ,var))))

       ((or (number? pattern) (boolean? pattern) (string? pattern) (char? pattern))
        `())

       ((null? pattern)
        `())

       ((pair? pattern)
        (let ((patt  (car pattern))
              (patts (cdr pattern)))
          (cond
           ;; QUOTE
           ((and (eq? patt 'quote) (pair? patts) (null? (cdr patts))) ;; (quote X)
            `())
           ;; NOT
           ((and (eq? patt 'not) (pair? patts) (null? (cdr patts))) ;; (not X)
            `())
           ;; AND
           ((eq? patt 'and)
            `(,@(apply append
                       (map (lambda [p] (clause->bindings var p)) patts))))
           ;; OR
           ((eq? patt 'or)
            (let ([top-var var]
                  [vars (map clause->vars patts)])
              (apply append
                     (map (lambda [vars patt]
                            (map (lambda [var]
                                   (list var `(match ,top-var
                                                [,patt ,var]
                                                [_ #f])))
                                 vars))
                          vars patts))))
           ;; (? PREDICATE) and (? PREDICATE ...)
           ((eq? patt '?)
            (if (and (pair? patts) (null? (cdr patts)))
                `()                                     ;; only (? predicate)
                (clause->bindings var `(and ,@patts)))) ;; general case
           ;; (xxx ...) or (xxx ___)
           ((or (equal? patts '(|...|)) (equal? patts '(|___|)))
            (let ([proxy-bindings (clause->vars patt)]
                  [param-var (gensym "list-param")])
              (map (lambda [binding]
                     `(,binding
                       (map
                        (lambda [,param-var]
                          (match ,param-var
                            [,patt
                             ,binding]))
                        ,var)))
                   proxy-bindings)))


           ;;------
           ;; A general list
           (else
            (let ([car-var (gensym "car")]
                  [cdr-var (gensym "cdr")])
              `([,car-var (car ,var)]
                ,@(clause->bindings car-var patt)
                [,cdr-var (cdr ,var)]
                ,@(clause->bindings cdr-var patts)))))))

       ((vector? pattern)
        (let ([patt (gensym "lst")])
          (append `((,patt (vector->list ,var)))
                  (clause->bindings patt (vector->list pattern)))))
       (else
        (error "unrecognized pattern: ~s" pattern))))

    ;; ==== Macro starts here
    (let ([expr-var (gensym "expr")])
      `(let ([,expr-var ,expr])
         (cond
          ,@(map
             (lambda [clause]
               (unless (list? clause) (error 'match "bad clause ~S" clause))
               (let ((patt (car clause))
                     (body (cdr clause)))
                 `(,(clause->condition expr-var patt)
                   (let* (,@(clause->bindings expr-var patt))
                     ,@body))))
             clauses)
          ;; No matching clause.
          (else (error 'match "no matching clause for ~s" ,expr-var))))))

  ;; ======================================================================
  ;; Extended match forms
  ;; ======================================================================
  (define-macro (match-lambda . clauses)
    (let ([var (gensym "match-lambda-var")])
      `(lambda [,var]
         (match ,var
           ,@clauses))))

  (define-macro (match-lambda* . clauses)
    (let ([var (gensym "match-lambda*-var")])
      `(lambda ,var
         (match ,var
           ,@clauses))))

  (define-macro (match-let . body)
    (if (symbol? (car body))
        (let* ([loop-name (car body)]
               [bindings (cadr body)]
               [vars (map (lambda _ (gensym "match-let-var")) bindings)]
               [body (cddr body)])
          `(let ,loop-name (,@(map (lambda [var binding]
                                     (list var (cadr bindings)))
                                   vars
                                   bindings))
                (match-let (,@(map (lambda [var binding]
                                     (list (car bindings) var))
                                   vars
                                   bindings))
                  ,@body)))
        (let* ([bindings (car body)]
               [body (cdr body)]
               [patterns (map car bindings)]
               [exprs (map cadr bindings)])
          `(match (list ,@exprs)
             [(,@patterns)
              ,@body]))))

  (define-macro (match-let* bindings . body)
    (if (null? bindings)
        `(begin ,@body)
        `(match ,(cadr (first bindings))
           (,(car (first bindings))
            (match-let* (,@(cdr bindings))
              ,@body)))))

  (define-macro (match-letrec bindings . body)
    (let* ([vars (map (lambda _ (gensym "match-letrec-var")) bindings)]
           [body (cddr body)])
      `(letrec (,@(map (lambda [var binding]
                         (list var (cadr bindings)))
                       vars
                       bindings))
         (match-let (,@(map (lambda [var binding]
                              (list (car bindings) var))
                            vars
                            bindings))
           ,@body)))))


(provide "stklos/smatch")
