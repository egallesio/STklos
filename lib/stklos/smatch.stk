;; smatch---reduced Wright-Cartwright-Shinn pattern matcher
;; This code is adapted from Alex Shinn’s public domain match-simple
;; but rewritten to unhygienic define-macro-s
;;
;; Original code rewriting author is Artyom Bologov (2026-09-12).
;;
;; Extended by Erick Gallesio (2026-02-27) to ensure that same variables in a
;; pattern are equal: (match '(1 2) ((a a) 1) ((a b) 2)) => 2
;; Previous call would return 1 with original match-simple


(define-module (stklos smatch)
  (export match
          match-lambda
          match-lambda*
          match-let
          match-let*
          match-letrec)

  (define-macro (match expr . clauses)

    (define (clause->vars pattern)
      (define (extract pattern vars)
        (cond
         ((eq? pattern '_)
          vars)

         ((symbol? pattern)
          (if (memq pattern vars)
              vars
              (cons pattern vars)))

         ((pair? pattern)
          (let ((patt  (car pattern))
                (patts (cdr pattern)))
          (cond
           ;; QUOTE
           ((and (eq? patt 'quote) (pair? patts) (null? (cdr patts))) ;; (quote X)
            vars)
           ;; NOT
           ((and (eq? patt 'not) (pair? patts) (null? (cdr patts))) ;; (not X)
            (extract patts vars))
           ;; AND
           ((eq? patt 'and)
            (extract patts vars))
           ;; OR
           ((eq? patt 'or)
            (extract patts vars))
           ;; (? PREDICATE ...)
           ((eq? patt '?)
            (extract (cdr patts) vars))
           ;; (xxx ...) or (xxxx ___)
           ((or (equal? patts '(|...|)) (equal? patts '(|___|)))
            (extract patt vars))
           ;; A general list
           (else
            (let ((new-vars (extract (car pattern) vars)))
              (extract (cdr pattern) new-vars))))))

         ((vector? pattern)
          (extract (vector->list pattern) vars))

         (else
          vars)))
      (extract pattern '()))

    (define (produce-set-or-test var value env)
      (let ((possible (key-get env :possible '()))
            (seen     (key-get env :seen '())))
        (if (memq var seen)
            ;; We have already seen this variable before. Test equality
            `(equal? ,var ,value)
            ;; First time we see this variable.
            ;; Register it if is a possible variable (do not set a variable
            ;; which is not in our generated let).
            (if (memq var possible)
                (let ((seen (cons var seen)))
                  (key-set! env :seen seen)
                  `(begin (set! ,var ,value) #t))
                #t))))


    (define (clause->condition var pattern env)
      (cond
       ((eq? pattern '_)
        #t)

       ((symbol? pattern)
;;//        (let ((possible (key-get env :possible '()))
;;//              (seen     (key-get env :seen '())))
;;//          (if (memq pattern seen)
;;//              ;; We have already seen this variable before. Test equality
;;//              `(equal? ,var ,pattern)
;;//              ;; First time we see this variable.
;;//              ;; Register it if is a possible variable (do not set a variable
;;//              ;; which is not in our generated let).
;;//              (if (memq pattern possible)
;;//                  (let ((seen (cons pattern seen)))
;;//                    (key-set! env :seen seen)
;;//                    `(begin (set! ,pattern ,var) #t))
;;//                  #t))))
        (produce-set-or-test pattern var env))
       
       ((or (number? pattern) (boolean? pattern) (string? pattern) (char? pattern))
        `(equal? ,var ,pattern))

       ((null? pattern)
        `(null? ,var))

       ((pair? pattern)
        (let ((patt   (car pattern))
              (patts (cdr pattern)))
          (cond
           ;; QUOTE
           ((and (eq? patt 'quote) (pair? patts) (null? (cdr patts))) ;; (quote X)
            `(equal? ,var ',(car patts)))
           ;; NOT
           ((and (eq? patt 'not) (pair? patts) (null? (cdr patts))) ;; (not X)
            `(not ,(clause->condition var (car patts) env)))
           ;; AND
           ((eq? patt 'and)
            `(and ,@(map (lambda [p] (clause->condition var p env)) patts)))
           ;; OR
           ((eq? patt 'or)
            `(or ,@(map (lambda [p] (clause->condition var p env)) patts)))
           ;; (? PREDICATE ...)
           ((eq? patt '?)
            (if (and (pair? patts) (null? (cdr patts)))
                `(,(car patts) ,var)             ;; only (? predicate)
                `(and (,(car patts) ,var)        ;; general case (? predicate x ...)
                      ,@(map (lambda [p] (clause->condition var p env)) patts))))
           ;; (xxx ...) or (xxxx ___)
           ((or (equal? patts '(|...|)) (equal? patts '(|___|)))
            (let ([param-var (gensym "var")]
                  [vars      (clause->vars patt)])
              `(and (list? ,var)
                    (every (lambda [,param-var]
                             (match ,param-var [,patt #t] [_  #f]))
                           ,var)

                    ,@(map (lambda [binding]
                             (produce-set-or-test
                                  binding
                                  `(map (lambda [,param-var]
                                          (match ,param-var [,patt ,binding]))
                                        ,var)
                                  env))
                           vars))))

           ;; A general list
           (else
            (let* ([car-var (gensym "car")]
                   [cdr-var (gensym "cdr")])
              `(and (pair? ,var)
                    (let ([,car-var (car ,var)]
                          [,cdr-var (cdr ,var)])
                      (and ,(clause->condition car-var (car pattern) env)
                           ,(clause->condition cdr-var (cdr pattern) env)))))))))

       ((vector? pattern)
        (if (zero? (vector-length pattern))
            `(equal? ,var #())                      ;; test if var is #()
            (let ([car-var (gensym "car")]          ;; var length is > 0
                  [cdr-var (gensym "cdr")]
                  [patt    (gensym "pattern")]
                  (lst     (vector->list pattern)))
              `(and (vector? ,var)
                    (positive? (vector-length ,var))
                    (let* ([,patt (vector->list ,var)]
                           [,car-var (car ,patt)]
                           [,cdr-var (cdr ,patt)])
                      (and ,(clause->condition car-var (car lst) env)
                           ,(clause->condition cdr-var (cdr lst) env)))))))

       (else
        (error "unrecognized pattern: ~s" pattern))))

    (define (match-one expr-var clauses)
      (if (null? clauses)
          `(error 'match "no matching clause for ~s" ,expr-var)
          (let ((clause (car clauses)))
            (unless (list? clause) (error 'match "bad clause ~S" clause))
            (let* ((patt (car clause))
                  (body (cdr clause))
                  (vars (clause->vars patt))
                  (env  (list :possible vars :seen '())))
              `(let ,(map (lambda (x) `(,x #void)) vars)
                 (if ,(clause->condition expr-var patt env)
                     (begin ;;; (,@(clause->bindings expr-var patt))
                       ,@body)
                     ,(match-one expr-var (cdr clauses))))))))

    ;; ==== Macro starts here
    (let ([expr-var (gensym "expr")])
      `(let ([,expr-var ,expr])
         ,(match-one expr-var clauses))))


  ;; ======================================================================
  ;; Extended match forms
  ;; ======================================================================
  (define-macro (match-lambda . clauses)
    (let ([var (gensym "match-lambda-var")])
      `(lambda [,var]
         (match ,var
           ,@clauses))))

  (define-macro (match-lambda* . clauses)
    (let ([var (gensym "match-lambda*-var")])
      `(lambda ,var
         (match ,var
           ,@clauses))))

  (define-macro (match-let . body)
    (if (symbol? (car body))
        (let* ([loop-name (car body)]
               [bindings (cadr body)]
               [vars (map (lambda _ (gensym "match-let-var")) bindings)]
               [body (cddr body)])
          `(let ,loop-name (,@(map (lambda [var binding]
                                     (list var (cadr bindings)))
                                   vars
                                   bindings))
                (match-let (,@(map (lambda [var binding]
                                     (list (car bindings) var))
                                   vars
                                   bindings))
                  ,@body)))
        (let* ([bindings (car body)]
               [body (cdr body)]
               [patterns (map car bindings)]
               [exprs (map cadr bindings)])
          `(match (list ,@exprs)
             [(,@patterns)
              ,@body]))))

  (define-macro (match-let* bindings . body)
    (if (null? bindings)
        `(begin ,@body)
        `(match ,(cadr (car bindings))
           (,(car (car bindings))
            (match-let* (,@(cdr bindings))
              ,@body)))))

  (define-macro (match-letrec bindings . body)
    (let* ([vars (map (lambda _ (gensym "match-letrec-var")) bindings)]
           [body (cddr body)])
      `(letrec (,@(map (lambda [var binding]
                         (list var (cadr bindings)))
                       vars
                       bindings))
         (match-let (,@(map (lambda [var binding]
                              (list (car bindings) var))
                            vars
                            bindings))
           ,@body))))
)

(provide "stklos/smatch")
