(define-module (srfi 277)
  (export open-cyclic-input-string
          open-cyclic-input-bytevector)


  (define (open-cyclic-input-string str)
    (let ((index  0)
          (len    (string-length str)))
      (open-input-virtual
       :read-char (lambda (p)
                    (when (>= index len) (set! index 0))
                    (let ((res (string-ref str index)))
                      (set! index (+ index 1))
                      res))
       :eof? (lambda (p) #f))))

  (define (open-cyclic-input-bytevector vec)
    (let ((index  0)
          (len    (bytevector-length vec)))
      (open-input-virtual
       :read-char (lambda (p)
                    (when (>= index len) (set! index 0))
                    (let ((res (bytevector-u8-ref vec index)))
                      (set! index (+ index 1))
                      (integer->char res)))
       :eof? (lambda (p) #f))))
  )

(provide "srfi/277")
