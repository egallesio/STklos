(define-library (srfi 270)
  (import SCHEME)
  (export write-hexadecimal-float)

  (begin
    (define (write-hexadecimal-float z . port)
      (let ((port (if (null? port) (current-output-port) port)))
        (display (number->string z 16) port)))))

(provide "srfi/270")
